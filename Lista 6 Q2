// Define um tipo para as funções de ataque: qualquer função que receba
// uma grade, dimensões e coordenadas, e devolva uma nova grade modificada.
// Isso permite trocar o ataque em tempo de execução sem if/switch.
typedef Grid (*AttackFunc)(Grid, int, int, int, int);

/* ── Explosão Arcana (turno único) ── */

// Aplica dano fixo em área: 50 de dano na camada 1, 25 na camada 2.
// Não modifica a grade original — trabalha na cópia e a retorna.
// Células que chegariam a HP negativo são travadas em 0.
Grid explosao_arcana_apply(Grid grid, int M, int N, int cx, int cy) {
    int **layer = compute_layers(M, N, cx, cy);
    Grid result = copy_grid(grid, M, N);

    for (int i = 0; i < M; i++) {
        for (int j = 0; j < N; j++) {
            // operador ternário encadeado para escolher o dano pela camada
            int dmg = (layer[i][j] == 1) ? 50 : (layer[i][j] == 2) ? 25 : 0;
            result[i][j] -= dmg;
            if (result[i][j] < 0) result[i][j] = 0;  // HP mínimo é 0
        }
    }
    free_layers(layer, M);
    return result;
}

/* ── Nuvem Venenosa (turno único) ── */

// Conta quantos vizinhos (nas 8 direções) ainda estão vivos (HP > 0).
// Isso influencia o dano da Nuvem Venenosa — quanto mais vizinhos vivos,
// mais o veneno se espalha e mais forte fica.
static int count_living_neighbors(Grid g, int M, int N, int r, int c) {
    int dr[] = {-1,-1,-1, 0, 0, 1, 1, 1};
    int dc[] = {-1, 0, 1,-1, 1,-1, 0, 1};
    int count = 0;
    for (int d = 0; d < 8; d++) {
        int nr = r + dr[d], nc = c + dc[d];
        if (nr >= 0 && nr < M && nc >= 0 && nc < N && g[nr][nc] > 0)
            count++;
    }
    return count;
}

// Aplica um turno de dano da Nuvem Venenosa.
// A fórmula é: dano = 5 + 8 × (número de vizinhos vivos).
// O dano é calculado com base no estado ANTES do turno (grid original),
// por isso usamos `grid` para contar vizinhos mas `result` para aplicar o dano —
// todas as células sofrem o efeito "ao mesmo tempo", sem influenciar umas às outras.
Grid nuvem_venenosa_apply(Grid grid, int M, int N, int cx, int cy) {
    int **layer = compute_layers(M, N, cx, cy);
    Grid result = copy_grid(grid, M, N);

    for (int i = 0; i < M; i++) {
        for (int j = 0; j < N; j++) {
            if (layer[i][j] > 0) {  // só afeta células dentro da área de efeito
                int vizinhos = count_living_neighbors(grid, M, N, i, j);
                int dmg = 5 + 8 * vizinhos;
                result[i][j] -= dmg;
                if (result[i][j] < 0) result[i][j] = 0;
            }
        }
    }
    free_layers(layer, M);
    return result;
}

