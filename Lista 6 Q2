// Condição de parada antecipada para a Nuvem Venenosa: se todos dentro
// da área de efeito já chegaram a 0, não faz sentido continuar os turnos.
static int area_all_dead(Grid g, int M, int N, int cx, int cy) {
    int **layer = compute_layers(M, N, cx, cy);
    int all_dead = 1;
